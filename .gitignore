.env
.env.*
.dev.vars
.dev.vars.*
.wrangler/
node_modules/
.DS_Store
*.cpuprofile

# The example file is published on purpose: Cloudflare reads it during a
# Deploy to Cloudflare to decide which secrets to prompt for. Real secrets
# still stay out via the .dev.vars rules above.
!.dev.vars.example

# PCScope (tools/pcscope) - local build and virtualenv output
__pycache__/
*.py[cod]
.venv/
venv/
build/
dist/
tools/pcscope/build-check.html
tools/pcscope/build-check.json
